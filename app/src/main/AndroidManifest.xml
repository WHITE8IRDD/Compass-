<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
    COMPASS - a hidden personal vault
    ============================================================================

    SECURITY NOTE #1 - THERE IS NO `android.permission.INTERNET`.

    This app is deliberately, permanently OFFLINE. Do not "helpfully" add the
    INTERNET permission, and do not add any library or SDK that declares it
    transitively (check the merged manifest of every release build).

    Why it matters:
      * The vault holds the most private files a person can own. With no
        network stack in the process, there is no code path that can exfiltrate
        a single byte - not by a malicious library, not by a compromised
        dependency, not by an ad SDK, not by an exploit that turns the app into
        a bot. The exfiltration channel simply does not exist.
      * It also means the app cannot phone home for "analytics" or crash
        reports. That is the point.
      * Attackers cannot remotely trigger anything in this app, because there
        is no way to reach it. The only way in is physical access to the
        device plus knowledge of the unlock gesture.

    The permissions that ARE declared are all local and offline:
      * USE_BIOMETRIC / USE_FINGERPRINT - to unlock with the platform API.
      * VIBRATE - a short haptic tick for the compass gesture.
      * READ_MEDIA_* (or READ_EXTERNAL_STORAGE on older Android) - optional,
        user-granted access for the MediaStore library. SAF file picking is
        still available if the user denies library access.
      * WRITE_EXTERNAL_STORAGE is limited to API 28 and below for legacy
        source deletion; modern Android uses system-controlled consent.
    ============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Biometric unlock (fingerprint / face). Legacy name kept for API 26-27. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- One short haptic tick when the secret gesture completes. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- MediaStore browsing. API 34+ may grant only user-selected visual media. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- The app is a compass first: the magnetometer is central to the UX,
         but the app stays usable (PIN unlock only) on devices without one. -->
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".CompassApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Compass"
        android:usesCleartextTraffic="false">

        <!--
            Single-activity architecture: one Activity, one screen at a time.
            FLAG_SECURE is applied to its window in MainActivity.onCreate(), so
            EVERY screen of the app (vault list, viewer, settings) is covered
            by the same protection.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
