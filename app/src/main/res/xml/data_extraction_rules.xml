<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules.

    The vault must NEVER be copied to a cloud backup: the encrypted files
    would end up on a server, and even though the key stays in the Keystore,
    a backup of the app data is one more thing an attacker could try to
    harvest. Nothing is backed up at all.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
